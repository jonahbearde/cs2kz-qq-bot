# CS2KZ QQ 小贴士机器人配置
# 用法：复制本文件为 .env，填入真实值。.env 已被 git 忽略，永不提交。
# 凭据获取：QQ 开放平台管理端 → 机器人 → 开发 → 开发设置（见手册第一章）。

# 机器人 AppID（一串数字）
QQ_APP_ID=

# 机器人 AppSecret（生成/重置时只显示一次，务必妥善保存）
QQ_APP_SECRET=

# Target Group 的 group_openid（不是 QQ 群号！）。
# 首次运行留空：启动机器人后在测试群 @ 它，把日志里醒目显示的
# group_openid 抄到下面，保存后重启机器人，即可收到第一条 Tip。
TARGET_GROUP_OPENID=

# 发送节奏（可不填，默认每 30 分钟一条，Send Window 09:00–24:00 北京时间）。
# 发送时刻对齐墙钟间隔边界（30 分钟即整点/半点）；窗口中途启动等下一对齐时刻。
# 测试群验收想快点看到效果：临时设 TIP_INTERVAL_MINUTES=1（每分钟一条，对齐整分钟），
# 验收完改回 30。间隔单位：分钟（≥1 的整数）。
TIP_INTERVAL_MINUTES=30

# Send Window 起止（HH:MM，北京时间；止可填 24:00，不含该时刻）。
SEND_WINDOW_START=09:00
SEND_WINDOW_END=24:00
